# Todas as variáveis do projeto. Local: copie os SEGREDOS para .env.development.local (não vai pro git).
# Servidor (Cloudflare/Vercel/etc.): cadastre todas como variáveis de ambiente.

# ---------- Supabase (supabase.com > Project Settings > API) ----------
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""          # anon public (pública)
SUPABASE_SERVICE_ROLE_KEY=""         # service_role — SEGREDO
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""     # mesma anon public
VITE_SUPABASE_PROJECT_ID=""

# ---------- Stripe (dashboard.stripe.com > Desenvolvedores > Chaves de API) ----------
# O modo (teste/produção) é definido pela pk: pk_test_ usa as chaves SANDBOX, pk_live_ usa as LIVE.
VITE_PAYMENTS_CLIENT_TOKEN=""        # pk_test_... ou pk_live_... (pública)
STRIPE_PUBLISHABLE_KEY=""            # pk_test_... ou pk_live_... (define o modo)
STRIPE_SANDBOX_API_KEY=""            # sk_test_... — SEGREDO
STRIPE_LIVE_API_KEY=""               # sk_live_... — SEGREDO
# Webhook: Desenvolvedores > Webhooks > Adicionar endpoint
#   URL: https://SEU_DOMINIO/api/public/payments/webhook?env=sandbox   (ou ?env=live)
#   Eventos: checkout.session.completed, payment_intent.succeeded
# Local: stripe listen --forward-to "localhost:8081/api/public/payments/webhook?env=sandbox"
PAYMENTS_SANDBOX_WEBHOOK_SECRET=""   # whsec_... — SEGREDO
PAYMENTS_LIVE_WEBHOOK_SECRET=""      # whsec_... — SEGREDO

# ---------- Mercado Pago (mercadopago.com.br/developers > Suas integrações > criar aplicação "Checkout Pro") ----------
# Credenciais de teste: token começa com TEST-; produção: APP_USR-
# Webhook: Suas integrações > Webhooks > URL https://SEU_DOMINIO/api/public/payments/mercadopago , evento "Pagamentos"
MERCADOPAGO_ACCESS_TOKEN=""          # SEGREDO
MERCADOPAGO_WEBHOOK_SECRET=""        # "Assinatura secreta" da tela de Webhooks — SEGREDO

# ---------- Melhor Envio (frete + etiquetas) ----------
# Teste: sandbox.melhorenvio.com.br | Produção: melhorenvio.com.br  > Integrações > Permissões de acesso > Gerar token
# Sem token o checkout usa frete fixo (R$ 25, grátis acima de R$ 350).
MELHOR_ENVIO_TOKEN=""                # SEGREDO
MELHOR_ENVIO_ENV="sandbox"           # sandbox | production
MELHOR_ENVIO_EMAIL=""                # email de contato técnico (vai no User-Agent)

# ---------- Área de membros (produtos digitais e híbridos) ----------
# Projeto isanetflix. Lá: Integrações/Plataformas de venda → MON Parfum → Gerar token, ligar e salvar.
# O site lista os cursos e cadastra os produtos lá (monparfum-catalog) e avisa as vendas (sales-webhook/monparfum);
# a área de membros cria a conta, libera os cursos e manda o e-mail de acesso.
VITE_MEMBERS_APP_URL=""             # endereço público da área do aluno (link "Área do aluno" / MON Club)
MEMBERS_AREA_API_URL=""              # https://<projeto-da-area-de-membros>.supabase.co/functions/v1
MEMBERS_AREA_TOKEN=""                # SEGREDO — o token gerado lá

# Endereço público do site (logo nos e-mails). Ex.: https://monparfum.com.br
SITE_URL=""

# ---------- Email transacional (resend.com > API Keys; domínio verificado em Domains) ----------
RESEND_API_KEY=""                    # re_... — SEGREDO
EMAIL_FROM="Mon Parfum <pedidos@seudominio.com.br>"

# Todas as chaves acima também podem ser salvas em Administração › Integrações (painel tem prioridade).
