{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monparfum",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "nova.experienciamon.com.br", "custom_domain": true }],
  "vars": { "SITE_URL": "https://nova.experienciamon.com.br" },
}
