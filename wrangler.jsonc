{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monparfum",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // shortcut: domínio nova.experienciamon.com.br está em outra conta Cloudflare; religar "routes" após wrangler login nela
  // "routes": [{ "pattern": "nova.experienciamon.com.br", "custom_domain": true }],
  "workers_dev": true,
  "vars": { "SITE_URL": "https://monparfum.carlostorellicomposicoes.workers.dev" },
}
